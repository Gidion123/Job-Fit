# Image for the Streamlit UI (CP3.2). It only calls the API (JOBFIT_API_URL).
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    JOBFIT_API_URL=http://api:8000

WORKDIR /app
RUN pip install "streamlit>=1.64,<2" "httpx>=0.27"   # UI v3 needs horizontal containers, st.space and icon_position
COPY ui/ ui/
# Theme, static font serving (ui/static) and the 5 MB upload limit.
COPY .streamlit/ .streamlit/
RUN chmod -R a+rX /app && useradd --create-home jobfit
USER jobfit

EXPOSE 8501
CMD ["sh", "-c", "streamlit run ui/streamlit_app.py --server.address 0.0.0.0 --server.port ${PORT:-8501} --browser.gatherUsageStats false"]
