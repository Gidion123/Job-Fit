# Image for the Streamlit UI (CP3.2). It only calls the API (JOBFIT_API_URL).
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    JOBFIT_API_URL=http://api:8000

WORKDIR /app
RUN pip install "streamlit>=1.40" "httpx>=0.27"   # st.fragment(run_every) and bar_chart(horizontal) need 1.40+
COPY ui/ ui/
RUN chmod -R a+rX /app && useradd --create-home jobfit
USER jobfit

EXPOSE 8501
CMD ["sh", "-c", "streamlit run ui/streamlit_app.py --server.address 0.0.0.0 --server.port ${PORT:-8501} --browser.gatherUsageStats false"]
