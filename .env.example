# Copy this file to .env and fill in the values yourself. Never commit .env or paste keys in chat.
# All LLM and embedding calls go through OpenRouter (DECISIONS D-030).
OPENROUTER_API_KEY=
DATABASE_URL=postgresql://jobfit:jobfit@localhost:5434/jobfit
# Budget guard (DECISIONS D-019, D-031). Set API_BUDGET_USD to the OpenRouter credit bought so far,
# and API_HARD_STOP_USD to that amount minus 0.50. Raise both only after an approved top-up.
API_BUDGET_USD=19
API_HARD_STOP_USD=18.5

# CP3 production settings (D-095, D-096). Everything is off unless set explicitly; missing or
# contradictory values stop the app (ConfigurationError) instead of falling back to a default.
# JOBFIT_ENV=dev                      # dev or prod
# JOBFIT_LIVE_ENABLED=0               # 1 = paid live analysis (needs OPENROUTER_API_KEY)
# JOBFIT_PUBLIC_LIVE=0                # 1 = public live; needs JOBFIT_ENV=prod and JOBFIT_LIVE_ENABLED=1
# In prod, always: DATABASE_URL (not the local default above) and
# JOBFIT_INTERNAL_TOKEN=              # at least 32 characters
# In prod with live on, also:
# JOBFIT_OWNER_TOKEN=                 # at least 32 characters
# JOBFIT_USAGE_LEDGER=/var/lib/jobfit/ledger/usage_ledger.jsonl
#                                     # absolute, directly in the fixed root /var/lib/jobfit/ledger (a named
#                                     # volume); never reports/usage/usage_ledger.jsonl. The Phase 2B runtime
#                                     # keeps <ledger>.intents.jsonl, <ledger>.breach.jsonl and the lock files
#                                     # next to it (D-101). Provision the root once before going live:
#                                     #   python -m jobfit.live.storage init --ledger <that path>
#                                     # Back up the database and the WHOLE root together (one recovery set).
# JOBFIT_DAILY_BUDGET_USD=            # D-096 calendar-day admission cap (enforced by the Phase 2B runtime)
# API_BUDGET_USD / API_HARD_STOP_USD  # lifetime ceiling of that ledger (frozen budget guard), set explicitly
# With public live on, also:
# JOBFIT_IP_HMAC_KEY=                 # at least 32 characters
# Streamlit (UI container, prod): JOBFIT_INTERNAL_TOKEN with the same value as the API's, sent on every
# request; the client IP is forwarded from the header Caddy sets (deployment phase).
